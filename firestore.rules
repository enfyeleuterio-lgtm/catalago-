rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin authorization helper: strictly authorized to enf.yeleuterio@gmail.com with verified email
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'enf.yeleuterio@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Helper for product validation
    function isValidProduct(data) {
      return data.keys().hasAll(['code', 'name', 'category', 'price', 'status']) &&
        data.code is string && data.code.size() <= 30 &&
        data.name is string && data.name.size() <= 100 &&
        data.category is string && data.category.size() <= 50 &&
        (data.price is int || data.price is float) && data.price >= 0 &&
        data.status in ['disponivel', 'vendida', 'reservada'];
    }

    // Helper for customer bag validation
    function isValidBag(data) {
      return data.keys().hasAll(['customerName', 'customerPhone', 'items', 'totalAmount', 'status']) &&
        data.customerName is string && data.customerName.size() <= 100 &&
        data.customerPhone is string && data.customerPhone.size() <= 50 &&
        data.items is list && data.items.size() <= 100 &&
        (data.totalAmount is int || data.totalAmount is float) && data.totalAmount >= 0 &&
        data.status in ['nova', 'separada', 'em_prova', 'finalizada'];
    }

    // Products Collection: Public read, Admin write
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(request.resource.data);
      allow update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // Bags Collection: Customers can create their bag, Admin can read/update/delete
    match /bags/{bagId} {
      allow create: if isValidBag(request.resource.data);
      allow read: if isAdmin();
      allow update: if isAdmin() && isValidBag(request.resource.data);
      allow delete: if isAdmin();
    }

    // Settings Document: Public read, Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
